{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nutsnews-worker-1",
  "main": "../src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "FEED_SHARD_INDEX": "1",
    "FEEDS_PER_SHARD": "20",
    "ENABLED_SUMMARY_LANGUAGES": "fr,ja,de-CH,de,el",
    "SUMMARY_TRANSLATION_LIMIT": "5",
    "HOLD_ARTICLES_FOR_TRANSLATIONS": "true",
    "AI_PROVIDER": "local",
    "LOCAL_AI_URL": "https://local-ai-ci.invalid",
    "LOCAL_AI_MODEL": "qwen2.5:3b",
    "AI_PROVIDER_FALLBACK_TO_OPENAI": "true",
    "AI_REVIEW_CONCURRENCY": "1"
  },
  "secrets_store_secrets": [
    {
      "binding": "SUPABASE_URL",
      "store_id": "ci-secrets-store-id",
      "secret_name": "SUPABASE_URL"
    },
    {
      "binding": "SUPABASE_SERVICE_ROLE_KEY",
      "store_id": "ci-secrets-store-id",
      "secret_name": "SUPABASE_SERVICE_ROLE_KEY"
    },
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "ci-secrets-store-id",
      "secret_name": "OPENAI_API_KEY"
    },
    {
      "binding": "BETTER_STACK_SOURCE_TOKEN",
      "store_id": "ci-secrets-store-id",
      "secret_name": "BETTER_STACK_SOURCE_TOKEN"
    },
    {
      "binding": "BETTER_STACK_INGESTING_HOST",
      "store_id": "ci-secrets-store-id",
      "secret_name": "BETTER_STACK_INGESTING_HOST"
    },
    {
      "binding": "LOCAL_AI_API_KEY",
      "store_id": "ci-secrets-store-id",
      "secret_name": "LOCAL_AI_API_KEY"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NUTSNEWS_KV",
      "id": "ci-kv-namespace-id",
      "preview_id": "ci-kv-namespace-id"
    }
  ]
}
