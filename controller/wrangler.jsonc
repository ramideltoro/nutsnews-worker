{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutsnews-controller",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FAILOVER_CONTROLLER_STATE",
        "class_name": "FailoverControllerStateObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-failover-controller-state",
      "new_sqlite_classes": ["FailoverControllerStateObject"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SHARD_COUNT": "25",
    "SHARD_RUN_INTERVAL_MINUTES": "5",
    "SHARD_WORKER_PREFIX": "nutsnews-worker",
    "SHARD_WORKER_SUBDOMAIN": "nutsnews",
    "MAX_AI_REVIEWS_PER_SHARD": "3",
    "TRANSLATION_BACKLOG_ENABLED": "true",
    "NUTSNEWS_FAILOVER_HEALTH_CHECK_INTERVAL_SECONDS": "15",
    "NUTSNEWS_FAILOVER_CONSECUTIVE_VPS_FAILURES": "3",
    "NUTSNEWS_FAILOVER_CONTROLLER_STALE_AFTER_SECONDS": "60",
    "NUTSNEWS_FAILOVER_CONTROLLER_VERSION": "controller-failover-storage-v1",
    "NUTSNEWS_FAILOVER_STATUS_SIGNATURE_TTL_SECONDS": "300",
    "NUTSNEWS_DNS_FAILOVER_APEX_HOSTNAME": "nutsnews.com",
    "NUTSNEWS_DNS_FAILOVER_WWW_HOSTNAME": "www.nutsnews.com",
    "NUTSNEWS_DNS_FAILOVER_VPS_TARGETS": "vps.nutsnews.com",
    "NUTSNEWS_DNS_FAILOVER_VERCEL_TARGETS": "cname.vercel-dns.com",
    "NUTSNEWS_DNS_FAILOVER_DNS_API_TIMEOUT_MS": "5000",
    "NUTSNEWS_FAILOVER_APEX_READINESS_URL": "https://nutsnews.com/readyz",
    "NUTSNEWS_FAILOVER_WWW_READINESS_URL": "https://www.nutsnews.com/readyz",
    "NUTSNEWS_FAILOVER_LIVE_ORIGIN_READINESS_TIMEOUT_MS": "5000",
    "NUTSNEWS_FAILOVER_LIVE_ORIGIN_PROPAGATION_WINDOW_SECONDS": "300"
  }
}
